# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Google Gemini (AI Photorealistic Blend)
GEMINI_API_KEY=your-gemini-api-key
# Optional override of the image model id
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# WhatsApp business number in international format, digits only
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Meta Model API: Muse Image fits the jewellery, SAM 3.1 finds the neck/face for the close-up.
MODEL_API_KEY=
# Optional: AI_IMAGE_PROVIDER=gemini to prefer Gemini; whichever key is also set acts as a fallback.
AI_IMAGE_PROVIDER=meta
# META_IMAGE_MODEL=muse-image-1.0
